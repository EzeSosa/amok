#!/usr/bin/env bash
# Lanzador de amok para Linux:  amok [carpeta]
# Abre la ventana en segundo plano y libera la terminal. Los errores van a ~/.cache/amok/amok.log.
#   AMOK_FOREGROUND=1 amok .   corre en primer plano mostrando la salida (para diagnosticar)
set -euo pipefail

APP_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
ELECTRON="$APP_DIR/node_modules/electron/dist/electron"

if [[ ! -x "$ELECTRON" ]]; then
  echo "amok: no encuentro Electron en $ELECTRON" >&2
  echo "Corré el instalador: bash \"$APP_DIR/scripts/install-linux.sh\"" >&2
  exit 1
fi

# El instalador escribe acá AMOK_NO_SANDBOX=1 si no se pudo habilitar el sandbox de Chromium.
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/amok/launcher.env"
# shellcheck source=/dev/null
[[ -r "$CONF" ]] && source "$CONF"

# Dentro de una terminal de amok: cambiar la carpeta de esa ventana (o abrir archivos) en vez de
# abrir otra. amok -n [carpeta] fuerza una ventana nueva.
if [[ "${1:-}" == -n || "${1:-}" == --new ]]; then
  shift
elif [[ -n "${AMOK_IPC:-}" ]]; then
  rc=0
  ELECTRON_RUN_AS_NODE=1 "$ELECTRON" "$APP_DIR/scripts/amok-send.js" "$@" || rc=$?
  if [[ $rc -ne 3 ]]; then exit "$rc"; fi
fi
unset AMOK_IPC AMOK_TOKEN

FLAGS=()
[[ "${AMOK_NO_SANDBOX:-}" == 1 ]] && FLAGS+=(--no-sandbox)

if [[ "${AMOK_FOREGROUND:-}" == 1 ]]; then
  exec "$ELECTRON" "$APP_DIR" "${FLAGS[@]}" "$@"
fi

LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/amok"
mkdir -p "$LOG_DIR"
setsid -f "$ELECTRON" "$APP_DIR" "${FLAGS[@]}" "$@" >"$LOG_DIR/amok.log" 2>&1 </dev/null
